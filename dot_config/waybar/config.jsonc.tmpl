// #######################################################################################
// DYNAMIC WAYBAR CONFIGURATION (GENERATED BY CHEZMOI)
// #######################################################################################
{
  "layer": "top",
  "position": "top",
  
  // Conditionally include modules depending on whether the system is a laptop
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [
    "tray", 
    "network", 
    "pulseaudio", 
    {{ if .has_battery }}"battery",{{ end }} 
    "clock", 
    "idle_inhibitor"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",   // Terminal
      "3": "",   // Browser
      "9": ""    // KeePass
    },
    "on-click": "activate"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}"
  },

  {{ if .has_battery }}
  "battery": {
    "tooltip": true,
    "tooltip-format" : "Time left: {time}",
    "tooltip-format-charging" : "Full in: {time}",
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format-charging" : "{capacity}% ",
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "interval" : 5
  },
  {{ end }}

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " Ethernet",
    "format-disconnected": " Disconnected",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "tooltip-format-wifi": "SSID: {essid}\n⇣ Speed: {bandwidthDownBits} \n⇡ Speed: {bandwidthUpBits}",
    "tooltip-format-ethernet": "Interface: {ifname}\n⇣ Speed: {bandwidthDownBits} \n⇡ Speed: {bandwidthUpBits}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", "", ""],
      "muted": ""
    },
    // Fixed click fallback: opens standard audio control panel via system packages
    "on-click" : "pavucontrol"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
