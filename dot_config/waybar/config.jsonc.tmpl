{
  "layer": "top",
  "position": "top",
  "spacing": 6, // Adds breathing room between modules
  
  "modules-left": [
    "hyprland/workspaces",
    "idle_inhibitor"
  ],
  "modules-center": [ "clock" ],
  "modules-right": [
    "network",
    "custom/tailscale", // Added foundation for your VPN
    "pulseaudio",
    "pulseaudio#microphone",
    {{ if .has_battery }}"battery",{{ end }}
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "3": "",
      "9": ""
    },
    "on-click": "activate",
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  {{ if .has_battery }}
  "battery": {
    "tooltip": true,
    "tooltip-format": "Time left: {time}",
    "tooltip-format-charging": "Full in: {time}",
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format-charging": "{capacity}% ",
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "interval": 5
  },
  {{ end }}

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " Ethernet",
    "format-disconnected": " Disconnected",
    "tooltip-format": "{ifname} via {gwaddr} ",
    // Added {ipaddr} here so you can quickly check your local IP
    "tooltip-format-wifi": "IP: {ipaddr}\nSSID: {essid}\n⇣ Speed: {bandwidthDownBits} \n⇡ Speed: {bandwidthUpBits}",
    "tooltip-format-ethernet": "IP: {ipaddr}\nInterface: {ifname}\n⇣ Speed: {bandwidthDownBits} \n⇡ Speed: {bandwidthUpBits}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "on-click": "nm-connection-editor" // Optional: click to open network manager
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    // -t 3 opens Pavucontrol directly to the Output Devices tab
    "on-click": "~/.config/waybar/scripts/audio-switcher.sh output",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    // -t 4 opens Pavucontrol directly to the Input Devices tab
    "on-click": "~/.config/waybar/scripts/audio-switcher.sh input",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },

  // Example Custom VPN Module
  "custom/tailscale": {
    "format": "{}",
    "exec": "tailscale status | grep -q 'Tailscale is awake' && echo '󰖂 ON' || echo '󰖂 OFF'",
    "interval": 10,
    "on-click": "tailscale up",
    "on-click-right": "tailscale down",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
