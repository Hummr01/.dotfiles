layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="LaTeX & AI" focus=true hide_floating_panes=true {
        pane split_direction="vertical" {
            pane name="Neovim (VimTeX)" size="68%" focus=true command="nvim"
            pane name="OpenCode AI" size="32%" command="opencode"
        }
        floating_panes {
            pane name="LaTeX Build / Shell (Alt+f)" x="10%" y="10%" width="80%" height="80%"
        }
    }

    tab name="Git & Shell" {
        pane split_direction="vertical" {
            pane name="LazyGit" size="60%" command="lazygit"
            pane name="Terminal" size="40%"
        }
    }
}
